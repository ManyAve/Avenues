// Publishes the built Storybook at https://avenues.manyave.com as a Worker with static assets only
// (no Worker code). Deploy by hand with `bun run deploy` (README, "Publishing Storybook", AVE-20); there is
// no CI. No secrets live here: wrangler uses whoever is signed in (`bunx wrangler login`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avenue-storybook",
  "account_id": "8c4c86e7a67f98c68db9598a13f75f6e",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./storybook-static",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "avenues.manyave.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
