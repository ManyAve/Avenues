{
  "name": "@manyave/avenue",
  "version": "0.55.0",
  "private": true,
  "description": "Avenue, ManyAve's design system: tokens, foundations, components and composites, shown in Storybook.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/avenue.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./desktop.css": "./src/styles/desktop.css",
    "./native/*": "./native/*",
    "./components/*": "./src/components/*.tsx",
    "./utils": "./src/lib/utils.ts",
    "./format": "./src/lib/format.ts",
    "./table-filters": "./src/lib/table-filters.ts",
    "./preferences-script": {
      "types": "./src/lib/preferences-script.d.mts",
      "default": "./src/lib/preferences-script.mjs"
    },
    "./checks/*": "./src/checks/*.ts",
    "./oxlint": {
      "types": "./lint/classes.d.mts",
      "default": "./lint/classes.mjs"
    }
  },
  "bin": {
    "avenue-check-patches": "./scripts/check-app-patches.ts"
  },
  "imports": {
    "#avenue/lib/dev": {
      "development": "./src/lib/dev.ts",
      "default": "./src/lib/dev-stub.ts"
    },
    "#avenue/lib/preferences-script": "./src/lib/preferences-script.mjs",
    "#avenue/lib/*": "./src/lib/*.ts",
    "#avenue/hooks/*": "./src/hooks/*.ts",
    "#avenue/components/*": "./src/components/*.tsx",
    "#avenue/checks/*": "./src/checks/*.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "oxlint --deny-warnings",
    "check:story-coverage": "bun scripts/check-story-coverage.ts",
    "test:scripts": "bun test scripts",
    "test:stories": "vitest run",
    "tokens:compare": "bun scripts/compare-tokens.ts",
    "tokens:native": "bun scripts/native-tokens.ts",
    "native:android": "bun scripts/native-android.ts",
    "native:android:check": "bun scripts/native-android.ts --check",
    "native:ios": "bun scripts/native-ios.ts",
    "visual:diff": "bun scripts/visual-diff.ts",
    "parity": "bun scripts/parity.ts",
    "ui-sdk:css": "bun scripts/ui-sdk-css.ts",
    "ui-sdk:skill": "bun scripts/ui-sdk-skill.ts",
    "shadcn:css": "bun scripts/shadcn-css.ts",
    "deploy": "bun run build-storybook && bun scripts/stamp-version.ts && cf deploy storybook-static",
    "check": "bun run typecheck && bun run lint && bun run test:scripts && bun run test:stories && bun run build-storybook && bun run check:story-coverage"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0",
    "oxlint": ">=1.43.0"
  },
  "peerDependenciesMeta": {
    "oxlint": { "optional": true }
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "cn": "^0.5.2",
    "cva": "1.0.0-beta.12",
    "lucide-react": "^1.77.0",
    "oxlint-tailwindcss": "^1.17.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "11.0.0-beta.3",
    "@storybook/addon-docs": "11.0.0-beta.3",
    "@storybook/addon-vitest": "11.0.0-beta.3",
    "@storybook/react-vite": "11.0.0-beta.3",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/culori": "^4.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vitest/browser-playwright": "5.1.1",
    "cf": "1.0.0-rc.2",
    "culori": "4.0.2",
    "oxlint": "^1.94.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.66.0-alpha-2026-11-20",
    "pngjs": "^7.0.0",
    "postcss": "8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "storybook": "11.0.0-beta.3",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.4.0-beta.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "@ui-sdk/core@0.1.0-beta.13": "patches/@ui-sdk%2Fcore@0.1.0-beta.13.patch"
  }
}
