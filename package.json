{
  "name": "@manyave/avenue",
  "version": "0.0.0",
  "private": true,
  "description": "Avenue, ManyAve's design system: tokens, foundations, components and composites, shown in Storybook.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/avenue.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./desktop.css": "./src/styles/desktop.css",
    "./components/*": "./src/components/*.tsx",
    "./utils": "./src/lib/utils.ts"
  },
  "imports": {
    "#avenue/lib/*": "./src/lib/*.ts",
    "#avenue/hooks/*": "./src/hooks/*.ts",
    "#avenue/components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "oxlint --deny-warnings",
    "check:classes": "bun scripts/check-classes.ts",
    "test:scripts": "bun test scripts",
    "tokens:compare": "bun scripts/compare-tokens.ts",
    "check": "bun run typecheck && bun run lint && bun run check:classes && bun run test:scripts && bun run build-storybook",
    "test:stories": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "11.0.0-beta.2",
    "@storybook/addon-docs": "11.0.0-beta.2",
    "@storybook/addon-vitest": "11.0.0-beta.2",
    "@storybook/react-vite": "11.0.0-beta.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "5.1.0",
    "oxlint": "^1.93.0",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "storybook": "11.0.0-beta.2",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
